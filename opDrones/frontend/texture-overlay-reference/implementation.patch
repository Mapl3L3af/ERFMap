+            await next.decode();
+            if (current !== revision) return;
+            image = next;
+        } catch {
+            if (current !== revision) return;
+            msg = 'Could not read the survey texture. Attach a JPEG, PNG, or WebP image.';
+        }
+        walk.invalidate();
+        render();
+    }
+    function sync(site) {
